TELEGRAM_BOT_TOKEN=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=cognitivecomputations/dolphin-mistral-24b-venice-edition:free
ADMIN_USER=admin
ADMIN_PASSWORD=change-me
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=mones
DB_HOST=postgres
DB_PORT=5432
DATABASE_URL=postgresql+psycopg://postgres:${DB_PASSWORD}@postgres:5432/mones
POSTGRES_PASSWORD=${DB_PASSWORD}
REDIS_URL=redis://redis:6379/0
SECRET_KEY=change-me
ALLOW_EXPLICIT_CONTENT=false
ENABLE_TEST_WALLET_TOPUP=false
SUPPORT_USERNAME=
DEFAULT_FREE_DAILY_LIMIT=30
DAILY_PASS_MESSAGE_LIMIT=500
WEEKLY_PASS_MESSAGE_LIMIT=500
MONTHLY_PASS_MESSAGE_LIMIT=500
PREMIUM_MESSAGE_LIMIT=1000

# Mones V4
VENICE_API_KEY=
VENICE_API_BASE_URL=https://api.venice.ai/api/v1
VENICE_MODEL=qwen-3-6-plus
LLM_DEBUG=false
PROMPT_MODE=simple_partner_v2
VENICE_TIMEOUT_SECONDS=60
TELEGRAM_MANAGEMENT_BOT_TOKEN=
TELEGRAM_MANAGEMENT_BOT_USERNAME=
TELEGRAM_CHAT_BOT_TOKEN=
TELEGRAM_CHAT_BOT_USERNAME=
ADMIN_TELEGRAM_IDS=
PAYMENT_LINK=https://www.coffeebede.com/gotomarket
ADMIN_MEDIA_FORWARD_ENABLED=true
ADMIN_MEDIA_REVIEW_CHAT_ID=
MANAGEMENT_BOT_USERNAME=moonesaibot
MANAGEMENT_BOT_URL=https://t.me/moonesaibot

# Coin billing defaults
BILLING_USD_TO_TOMAN=60000
BILLING_PROFIT_MARGIN_PERCENT=100
BILLING_SIGNUP_BONUS_COINS=200
# Image generation reuses VENICE_API_KEY and VENICE_API_BASE_URL; no additional image secret is required.

# Memory V2 (off by default; no data migration required)
# Shadow measures context size only and keeps existing prompts unchanged.
MONES_MEMORY_V2_SHADOW=false
# Enables budgeted episodic retrieval and explicit user-memory writes.
MONES_MEMORY_V2_ENABLED=false

# Requires Alembic 0042; off by default until staging verification.
MONES_TEMPORAL_MEMORY_ENABLED=false

# Experimental opt-in hybrid semantic retrieval; default OFF (requires migrations 0043 and 0044).
MONES_SEMANTIC_MEMORY_ENABLED=false
MONES_SEMANTIC_EMBEDDING_MODEL=text-embedding-bge-m3
# Explicit per-user allowlist, populated only after real user consent.
# Both persistent /memory_on consent and this admin allowlist are required.
# Used by manual indexing script; empty means no users can be indexed.
MONES_SEMANTIC_OPT_IN_USER_IDS=
